<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TrfProbe</AssemblyName>
    <RootNamespace>TRF.Sharp.Probe</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile the library sources directly so that `internal` helpers
         (Common, Trf) are reachable for low-level A/B probes. -->
    <Compile Include="../../../src/TRF.Sharp/**/*.cs"
             Exclude="../../../src/TRF.Sharp/obj/**/*.cs;../../../src/TRF.Sharp/bin/**/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

</Project>
