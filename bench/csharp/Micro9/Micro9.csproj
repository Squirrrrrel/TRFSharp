<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Micro9</AssemblyName>
    <RootNamespace>TRF.Sharp.Bench.Micro9</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/TRF.Sharp/TRF.Sharp.csproj" />
    <!-- compiled from source so the probe can call internal helpers -->
    <Compile Include="..\..\..\src\TRF.Sharp\Core\ThinQr.cs" Link="ThinQr.cs" />
  </ItemGroup>

</Project>
